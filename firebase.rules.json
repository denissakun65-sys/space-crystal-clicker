{
  "rules": {
    "online": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','lastSeen'])"
      }
    },
    "messages": {
      ".read": "auth != null",
      "$messageId": {
        ".write": "auth != null && newData.child('uid').val() === auth.uid",
        "reacts": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "whispers": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid",
        "$messageId": {
          ".write": "auth != null"
        }
      }
    },
    "gifts": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid",
        "$giftId": {
          ".write": "auth != null"
        }
      }
    }
  }
}
